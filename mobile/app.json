{
  "expo": {
    "name": "HousAlert",
    "slug": "housalert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "housalert",
    "splash": {
      "backgroundColor": "#0D6EFD",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.housalert.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D6EFD"
      },
      "package": "com.housalert.app"
    },
    "plugins": [
      "expo-splash-screen"
    ]
  }
}
