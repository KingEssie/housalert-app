# Copy this file to .env and fill in your values before building for Android.
# NEVER commit .env — it is listed in .gitignore.

# ── Required (Supabase) ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Optional (Maps / Push / Stripe) ────────────────────────────────────────
VITE_MAPBOX_TOKEN=
VITE_VAPID_PUBLIC_KEY=

# ── Server-side only (not needed for Android Capacitor build) ───────────────
# SESSION_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VAPID_PRIVATE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAILS=
# APP_PUBLIC_BASE_URL=
